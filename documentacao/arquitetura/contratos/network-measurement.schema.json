{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:linka:network-measurement:v1",
  "title": "Linka NetworkMeasurement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "measuredAt", "outcome"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "measuredAt": { "type": "string", "format": "date-time" },
    "outcome": { "type": "string", "enum": ["complete", "partial"] },
    "downloadMbps": { "type": "number", "minimum": 0 },
    "uploadMbps": { "type": "number", "minimum": 0 },
    "latencyMs": { "type": "number", "minimum": 0 },
    "jitterMs": { "type": "number", "minimum": 0 },
    "packetLossPercent": { "type": "number", "minimum": 0, "maximum": 100 },
    "loadedLatencyMs": { "type": "number", "minimum": 0 },
    "loadedLatencyUploadMs": { "type": "number", "minimum": 0 },
    "loadResponsiveness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methodologyVersion", "environmentIdentifier", "integrity"],
      "properties": {
        "methodologyVersion": { "const": 1 },
        "environmentIdentifier": { "type": "string", "minLength": 1 },
        "integrity": { "type": "string", "enum": ["valid", "baselineInconclusive", "downloadInconclusive", "uploadInconclusive"] },
        "baseline": { "$ref": "#/$defs/latencyEvidence" },
        "download": { "$ref": "#/$defs/loadPhaseEvidence" },
        "upload": { "$ref": "#/$defs/loadPhaseEvidence" }
      }
    },
    "durationMs": { "type": "integer", "minimum": 0 },
    "connectionKind": { "type": "string", "enum": ["wifi", "cellular", "ethernet", "other"] },
    "networkIdentifier": { "type": "string" },
    "serverIdentifier": { "type": "string" },
    "engineVersion": { "type": "string" }
  },
  "$defs": {
    "latencyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["medianMs", "p95Ms", "maximumMs", "sampleCount", "timeoutCount", "warmupDurationMs"],
      "properties": {
        "medianMs": { "type": "number", "minimum": 0 },
        "p95Ms": { "type": "number", "minimum": 0 },
        "maximumMs": { "type": "number", "minimum": 0 },
        "sampleCount": { "type": "integer", "minimum": 1 },
        "timeoutCount": { "type": "integer", "minimum": 0 },
        "warmupDurationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "loadPhaseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usefulDurationMs", "bytesTransferred", "saturation"],
      "properties": {
        "latency": { "$ref": "#/$defs/latencyEvidence" },
        "usefulDurationMs": { "type": "integer", "minimum": 0 },
        "bytesTransferred": { "type": "integer", "minimum": 0 },
        "averageMbps": { "type": "number", "minimum": 0 },
        "saturation": { "type": "string", "enum": ["sustained", "insufficient"] }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "complete" } },
        "required": ["outcome"]
      },
      "then": {
        "required": ["downloadMbps", "uploadMbps", "latencyMs"]
      }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "partial" } },
        "required": ["outcome"]
      },
      "then": {
        "anyOf": [
          { "required": ["downloadMbps"] },
          { "required": ["uploadMbps"] },
          { "required": ["latencyMs"] },
          { "required": ["jitterMs"] },
          { "required": ["packetLossPercent"] },
          { "required": ["loadedLatencyMs"] }
        ]
      }
    }
  ]
}
