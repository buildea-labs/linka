{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/content/**",
              "components/core/**",
              "components/layout/**",
              "components/speedtest/**",
              "guidelines/frames/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:format|label|note|style|key|ref|className|style|children)$/]",
        "message": "<AdSlot> doesn't accept that prop. Declared props: format, label, note, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdSlot'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:leaderboard|banner)$/]",
        "message": "<AdSlot> format must be one of 'leaderboard' | 'banner'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|variant|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, icon, variant, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plain|subtle|tinted|filled)$/]",
        "message": "<Button> variant must be one of 'plain' | 'subtle' | 'tinted' | 'filled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|dashed|label|padding|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, dashed, label, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|values|key|ref|className|style|children)$/]",
        "message": "<ComparisonRow> doesn't accept that prop. Declared props: label, values."
      },
      {
        "selector": "JSXOpeningElement[name.name='DetailsDisclosure'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|defaultOpen|key|ref|className|style|children)$/]",
        "message": "<DetailsDisclosure> doesn't accept that prop. Declared props: label, children, defaultOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|tone|as|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, size, tone, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Eyebrow> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:secondary|primary|accent)$/]",
        "message": "<Eyebrow> tone must be one of 'secondary' | 'primary' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|rotate|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, rotate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LegalSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|spacing|style|key|ref|className|style|children)$/]",
        "message": "<LegalSection> doesn't accept that prop. Declared props: title, children, spacing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:progress|value|unit|connecting|size|key|ref|className|style|children)$/]",
        "message": "<MetricRing> doesn't accept that prop. Declared props: progress, value, unit, connecting, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHero'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|lead|children|align|maxWidth|style|key|ref|className|style|children)$/]",
        "message": "<PageHero> doesn't accept that prop. Declared props: eyebrow, title, lead, children, align, maxWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHero'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<PageHero> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhaseDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:phases|activeKey|key|ref|className|style|children)$/]",
        "message": "<PhaseDots> doesn't accept that prop. Declared props: phases, activeKey."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:copyright|tagline|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: copyright, tagline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<SiteNavItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatDisplay'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|accent|key|ref|className|style|children)$/]",
        "message": "<StatDisplay> doesn't accept that prop. Declared props: label, value, unit, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|align|style|key|ref|className|style|children)$/]",
        "message": "<StatusLabel> doesn't accept that prop. Declared props: children, tone, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusLabel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:active|pending)$/]",
        "message": "<StatusLabel> tone must be one of 'active' | 'pending'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusLabel'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|start)$/]",
        "message": "<StatusLabel> align must be one of 'center' | 'start'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|label|children|style|key|ref|className|style|children)$/]",
        "message": "<StepItem> doesn't accept that prop. Declared props: number, label, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|arrow|onClick|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: children, href, arrow, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ValueCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|action|align|style|key|ref|className|style|children)$/]",
        "message": "<ValueCard> doesn't accept that prop. Declared props: label, children, action, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ValueCard'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<ValueCard> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|dotColor|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, color, dotColor."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Wordmark> size must be one of 'sm' | 'md' | 'lg'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
