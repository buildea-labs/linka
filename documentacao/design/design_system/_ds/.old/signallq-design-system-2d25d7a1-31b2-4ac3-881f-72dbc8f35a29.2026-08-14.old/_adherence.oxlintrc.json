{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "input",
            "message": "Use <Checkbox> from the design system instead of <input>."
          },
          {
            "element": "dialog",
            "message": "Use <Dialog> from the design system instead of <dialog>."
          },
          {
            "element": "input",
            "message": "Use <TextField> from the design system instead of <input>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/animations/Thinking/**",
              "components/animations/TypeOut/**",
              "components/brand/Logo/**",
              "components/controls/Button/**",
              "components/controls/Checkbox/**",
              "components/controls/Chip/**",
              "components/controls/Dialog/**",
              "components/controls/IconButton/**",
              "components/controls/SegmentedControl/**",
              "components/controls/Switch/**",
              "components/controls/Tabs/**",
              "components/controls/TextField/**",
              "components/general/SignallQThemeProvider/**",
              "components/layout/BottomNav/**",
              "components/layout/Card/**",
              "components/layout/Overline/**",
              "components/layout/PhoneFrame/**",
              "components/layout/ScreenScroll/**",
              "components/layout/SheetFrame/**",
              "components/layout/StatusBar/**",
              "components/layout/TopBar/**",
              "components/primitives/Avatar/**",
              "components/primitives/Badge/**",
              "components/primitives/Icon/**",
              "components/primitives/SignalBars/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Google Sans Flex|Roboto|Material Symbols Outlined))/i]",
        "message": "Font not provided by the design system. Available: Google Sans Flex, Roboto, Material Symbols Outlined."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|letter|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: size, letter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|bg|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, color, bg, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onChange|key|ref|className|style|children)$/]",
        "message": "<BottomNav> doesn't accept that prop. Declared props: active, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:home|speed|sinal|hist|ajustes)$/]",
        "message": "<BottomNav> active must be one of 'home' | 'speed' | 'sinal' | 'hist' | 'ajustes'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|disabled|fullWidth|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, icon, disabled, fullWidth, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|tonal|outlined|text|danger)$/]",
        "message": "<Button> variant must be one of 'filled' | 'tonal' | 'outlined' | 'text' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|onClick|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|disabled|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: active, disabled, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|confirmLabel|cancelLabel|danger|onConfirm|onCancel|children|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: icon, title, description, confirmLabel, cancelLabel, danger, onConfirm, onCancel, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|fill|weight|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, fill, weight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|color|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: name, color, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|background|size|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, background, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:symbol|lockup)$/]",
        "message": "<Logo> variant must be one of 'symbol' | 'lockup'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='background'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Logo> background must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Overline'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Overline> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhoneFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<PhoneFrame> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreenScroll'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<ScreenScroll> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SheetFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<SheetFrame> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignalBars'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|color|big|key|ref|className|style|children)$/]",
        "message": "<SignalBars> doesn't accept that prop. Declared props: level, color, big."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignallQThemeProvider'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|children|key|ref|className|style|children)$/]",
        "message": "<SignallQThemeProvider> doesn't accept that prop. Declared props: mode, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignallQThemeProvider'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:light|dark|system)$/]",
        "message": "<SignallQThemeProvider> mode must be one of 'light' | 'dark' | 'system'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|key|ref|className|style|children)$/]",
        "message": "<StatusBar> doesn't accept that prop. Declared props: time."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|onChange|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: on, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: options, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|placeholder|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, value, placeholder, disabled, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Thinking'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|key|ref|className|style|children)$/]",
        "message": "<Thinking> doesn't accept that prop. Declared props: style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|icon|leading|action|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: title, icon, leading, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='TypeOut'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|speed|onDone|key|ref|className|style|children)$/]",
        "message": "<TypeOut> doesn't accept that prop. Declared props: text, speed, onDone."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Avatar": {
        "replaces": []
      },
      "Badge": {
        "replaces": []
      },
      "BottomNav": {
        "replaces": []
      },
      "Button": {
        "replaces": [
          "button"
        ]
      },
      "Card": {
        "replaces": []
      },
      "Checkbox": {
        "replaces": [
          "input[type=checkbox]"
        ]
      },
      "Chip": {
        "replaces": []
