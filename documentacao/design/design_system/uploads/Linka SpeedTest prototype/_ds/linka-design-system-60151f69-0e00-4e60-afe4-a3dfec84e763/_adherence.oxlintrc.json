{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/speedtest/**",
              "ui_kits/speedtest-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Quicksand))/i]",
        "message": "Font not provided by the design system. Available: Quicksand."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|variant|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, icon, variant, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|subtle)$/]",
        "message": "<Button> variant must be one of 'ghost' | 'subtle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|dashed|label|padding|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, dashed, label, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DetailsDisclosure'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|defaultOpen|key|ref|className|style|children)$/]",
        "message": "<DetailsDisclosure> doesn't accept that prop. Declared props: label, children, defaultOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:progress|value|unit|connecting|size|key|ref|className|style|children)$/]",
        "message": "<MetricRing> doesn't accept that prop. Declared props: progress, value, unit, connecting, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhaseDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:phases|activeKey|key|ref|className|style|children)$/]",
        "message": "<PhaseDots> doesn't accept that prop. Declared props: phases, activeKey."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatDisplay'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|accent|key|ref|className|style|children)$/]",
        "message": "<StatDisplay> doesn't accept that prop. Declared props: label, value, unit, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Wordmark> size must be one of 'sm' | 'md' | 'lg'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
      },
      "Card": {
        "replaces": []
      },
      "DetailsDisclosure": {
        "replaces": []
      },
      "MetricRing": {
        "replaces": []
      },
      "PhaseDots": {
        "replaces": []
      },
      "StatDisplay": {
        "replaces": []
      },
      "Wordmark": {
        "replaces": []
      }
    },
