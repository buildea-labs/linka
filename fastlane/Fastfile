# Fastfile – Linka iOS
# Pipeline de deploy automático para TestFlight
#
# Secrets necessários (GitHub → Settings → Secrets and variables → Actions):
#   ASC_KEY_ID      → ID da chave da App Store Connect API (ex: XXXXXXXXXX)
#   ASC_ISSUER_ID   → Issuer ID da App Store Connect API (UUID)
#   ASC_KEY_CONTENT → Conteúdo do arquivo .p8 codificado em Base64
#                     Gere com: base64 -i AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
#   APPLE_TEAM_ID   → ID do time Apple Developer (ex: 2Z4T8228GR)

default_platform(:ios)

require "base64"
require "digest"
require "json"
require "shellwords"
require "tmpdir"

platform :ios do
  # ------------------------------------------------------------------
  # Lane: beta
  # Faz build, archive e upload para TestFlight
  # ------------------------------------------------------------------
  desc "Build e upload para TestFlight via App Store Connect API"
  lane :beta do
    required_envs = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENT APPLE_TEAM_ID]
    missing_envs = required_envs.reject { |name| ENV[name] && !ENV[name].empty? }
    UI.user_error!("Secrets ausentes: #{missing_envs.join(', ')}") unless missing_envs.empty?

    project_yml = File.expand_path("../aplicativo-ios/project.yml", __dir__)
    release_notes_path = File.expand_path("../RELEASE_NOTES.md", __dir__)
    project_contents = File.read(project_yml)
    version = project_contents[/MARKETING_VERSION:\s*"([0-9]+(?:\.[0-9]+){1,2})"/, 1]
    build_number = project_contents[/CURRENT_PROJECT_VERSION:\s*"([0-9]+)"/, 1]
    UI.user_error!("Versão ou build ausente em #{project_yml}") unless version && build_number
    UI.user_error!("RELEASE_NOTES.md é obrigatório para TestFlight") unless File.exist?(release_notes_path) && !File.read(release_notes_path).strip.empty?

    # 1. Autenticação na App Store Connect via API Key
    api_key = app_store_connect_api_key(
      key_id:        ENV["ASC_KEY_ID"],
      issuer_id:     ENV["ASC_ISSUER_ID"],
      key_content:   ENV["ASC_KEY_CONTENT"],  # conteúdo .p8 em Base64
      is_key_content_base64: true,
      in_house: false
    )

    # O runner efêmero também precisa da chave para criar ou baixar os
    # perfis de distribuição do app e do widget durante o archive.
    authentication_key_path = File.join(Dir.tmpdir, "AuthKey_#{ENV['ASC_KEY_ID']}.p8")
    File.binwrite(authentication_key_path, Base64.strict_decode64(ENV.fetch("ASC_KEY_CONTENT")))
    authentication_xcargs = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{authentication_key_path.shellescape}",
      "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID').shellescape}",
      "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID').shellescape}"
    ].join(" ")

    begin
      latest_build = latest_testflight_build_number(
        version: version,
        app_identifier: "com.linka.assist",
        api_key: api_key,
        initial_build_number: 0
      )
      UI.user_error!("Build #{version} (#{build_number}) não é novo; Apple já tem build #{latest_build}.") if latest_build >= build_number.to_i

      # 2. Gerar projeto Xcode com XcodeGen
      sh("xcodegen generate --spec #{project_yml.shellescape} --project #{File.dirname(project_yml).shellescape}")

      # 3. Build e Archive (IPA para App Store)
      gym(
        project:          "aplicativo-ios/LinkaApp.xcodeproj",
        scheme:           "LinkaApp",
        configuration:    "Release",
        export_method:    "app-store",
        clean:            true,
        xcargs:           authentication_xcargs,
        output_directory: "build",
        output_name:      "LinkaApp.ipa"
      )

      # 4. As notas aprovadas na PR candidata são obrigatórias.
      changelog = File.read(release_notes_path)

      # 5. Upload para TestFlight
      pilot(
        api_key:                         api_key,
        ipa:                             "build/LinkaApp.ipa",
        changelog:                       changelog,
        distribute_external:             false,
        notify_external_testers:         false,
        skip_waiting_for_build_processing: false,
        wait_processing_interval: 30
      )

      processed_build = latest_testflight_build_number(
        version: version,
        app_identifier: "com.linka.assist",
        api_key: api_key,
        initial_build_number: 0
      )
      UI.user_error!("Apple não confirmou o processamento de #{version} (#{build_number}).") unless processed_build == build_number.to_i

      ipa_path = File.expand_path("build/LinkaApp.ipa", Dir.pwd)
      evidence_path = File.expand_path("build/testflight-evidence.json", Dir.pwd)
      File.write(evidence_path, JSON.pretty_generate({
        version: version,
        build: build_number.to_i,
        git_sha: ENV.fetch("GITHUB_SHA", "local"),
        ipa_sha256: Digest::SHA256.file(ipa_path).hexdigest,
        processed_build: processed_build
      }))
      UI.important("TestFlight processado: #{version} (#{build_number}), SHA #{ENV.fetch('GITHUB_SHA', 'local')}")
    ensure
      File.delete(authentication_key_path) if File.exist?(authentication_key_path)
    end

    # A tag é criada pela workflow somente depois da confirmação da Apple.
    # Tags vX.Y.Z continuam reservadas para a promoção pública autorizada.
  end
end
